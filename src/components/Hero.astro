---
import Isotipo from '../assets/logo/isotipo.svg';
---

<section class="hero">
	<div class="container hero__inner">
		<div class="hero__copy">
			<p class="eyebrow">Materiales y componentes eléctricos</p>
			<h1>
				Conectamos tu empresa con fabricantes certificados, sin intermediarios
			</h1>
			<p class="hero__subtitle">
				Acero al silicio CRGO/CRNGO, núcleos enrollados, serie Uni-Core,
				laminaciones y núcleos apilados, y núcleos toroidales — directo de
				fábrica, con la ficha técnica que necesitas para tu proyecto.
			</p>
			<a href="/#hablemos" class="btn btn-primary">Contáctanos</a>
		</div>

		<div class="hero__visual" aria-hidden="true">
			<div class="hero__stage">
				<Isotipo class="hero__isotipo" />
			</div>
		</div>
	</div>
</section>

<style>
	.hero {
		background: var(--color-hero-bg);
		color: var(--color-white);
		padding: 0;
	}

	.hero__inner {
		position: relative;
		display: grid;
		grid-template-columns: 1.1fr 0.9fr;
		align-items: center;
		gap: 48px;
		padding-top: 24px;
		padding-bottom: 24px;
	}

	.hero__copy h1 {
		font-size: clamp(1.8rem, 5vw, 3.1rem);
		color: var(--color-white);
		margin: 16px 0 20px;
	}

	.hero__subtitle {
		font-family: var(--font-body);
		font-size: clamp(0.95rem, 2.5vw, 1.05rem);
		line-height: 1.6;
		color: #d3d5d8;
		max-width: 46ch;
		margin-bottom: 32px;
	}

	.hero__visual {
		display: flex;
		align-items: center;
		justify-content: center;
		--logo-graphite: #ffffff;
	}

	.hero__stage {
		perspective: 900px;
		width: min(320px, 60vw);
		aspect-ratio: 223 / 347;
	}

	.hero__isotipo {
		width: 100%;
		height: 100%;
		filter: drop-shadow(0 20px 40px rgba(0, 0, 0, 0.35));
		animation: spin-3d 7s linear infinite;
		transform-style: preserve-3d;
	}

	@keyframes spin-3d {
		from {
			transform: rotateY(0deg);
		}
		to {
			transform: rotateY(360deg);
		}
	}

	@media (max-width: 1023px) {
		.hero__inner {
			grid-template-columns: 1fr;
			padding-top: 12px;
			padding-bottom: 12px;
			gap: 4px;
		}

		.hero__copy {
			position: relative;
			z-index: 1;
		}

		.hero__copy h1 {
			max-width: 24ch;
		}

		.hero__subtitle {
			margin-bottom: 20px;
		}

		/* Below 1024px the isotipo drops its own layout block entirely and
		   becomes a subtle watermark behind the copy — large, low-opacity,
		   monochrome, non-interactive — instead of a separate visual that
		   pushes the hero taller. */
		.hero__visual {
			position: absolute;
			inset: 0;
			z-index: 0;
			opacity: 0.1;
			pointer-events: none;
			--logo-orange: #ffffff;
		}

		/* No fixed px cap and no forced aspect-ratio here: the stage is sized
		   purely as a fraction of the watermark's own box (which spans the
		   full hero via inset:0), in both dimensions. The isotipo svg's
		   default preserveAspectRatio ("meet") then contains itself inside
		   whatever w×h that box works out to at the current viewport —
		   scaling proportionally with no distortion and no edge clipping,
		   whichever dimension (width or height) ends up the tighter fit. */
		.hero__stage {
			width: 85%;
			height: 85%;
			aspect-ratio: auto;
		}

		.hero__isotipo {
			animation: none;
			filter: none;
		}
	}

	@media (max-width: 400px) {
		.hero__inner {
			padding-top: 8px;
			padding-bottom: 8px;
		}

		.hero__subtitle {
			margin-bottom: 16px;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.hero__isotipo {
			animation: none;
		}
	}
</style>
