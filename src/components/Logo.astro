---
import Isotipo from '../assets/logo/isotipo.svg';
import Wordmark from '../assets/logo/wordmark.svg';

interface Props {
	/** Height in pixels of the isotipo; the wordmark scales to match. */
	size?: number;
	/** "dark" (default) for light backgrounds, "light" for dark backgrounds — recolors the graphite shape only, via CSS variables, the artwork itself is untouched. */
	variant?: 'dark' | 'light';
	class?: string;
}

const { size = 40, variant = 'dark', class: className } = Astro.props;
const graphiteVar = variant === 'light' ? '#ffffff' : undefined;
---

<a
	href="/"
	class:list={['logo', className]}
	aria-label="Zolven — inicio"
	style={graphiteVar ? `--logo-graphite: ${graphiteVar}` : undefined}
>
	<Isotipo class="logo__isotipo" style={`height: ${size}px`} />
	<Wordmark class="logo__wordmark" style={`height: ${size * 0.62}px`} />
</a>

<style>
	.logo {
		display: inline-flex;
		align-items: center;
		gap: 0.5em;
		text-decoration: none;
		line-height: 0;
	}

	.logo__isotipo,
	.logo__wordmark {
		width: auto;
		display: block;
		overflow: visible;
	}

	.logo__isotipo :global(.iso-shape) {
		transform-box: fill-box;
		transform-origin: center;
		animation-duration: 0.65s;
		animation-timing-function: cubic-bezier(0.2, 0.8, 0.3, 1.3);
		animation-fill-mode: both;
	}

	.logo__isotipo :global(.iso-graphite) {
		animation-name: logo-iso-in-left;
	}

	.logo__isotipo :global(.iso-orange) {
		animation-name: logo-iso-in-right;
	}

	.logo__wordmark :global(.wm-letter) {
		opacity: 0;
		transform-box: fill-box;
		animation-name: logo-wm-fade-in;
		animation-duration: 0.25s;
		animation-timing-function: ease-out;
		animation-fill-mode: both;
	}

	.logo__wordmark :global(.wm-z) {
		animation-delay: 0.7s;
	}

	.logo__wordmark :global(.wm-o) {
		animation-delay: 0.78s;
	}

	.logo__wordmark :global(.wm-l) {
		animation-delay: 0.86s;
	}

	.logo__wordmark :global(.wm-v) {
		animation-delay: 0.94s;
	}

	.logo__wordmark :global(.wm-e) {
		animation-delay: 1.02s;
	}

	.logo__wordmark :global(.wm-n) {
		animation-delay: 1.1s;
	}

	@keyframes logo-iso-in-left {
		from {
			opacity: 0;
			transform: translateX(-160%) rotate(-110deg);
		}
		60% {
			opacity: 1;
		}
		to {
			opacity: 1;
			transform: translateX(0) rotate(0deg);
		}
	}

	@keyframes logo-iso-in-right {
		from {
			opacity: 0;
			transform: translateX(160%) rotate(110deg);
		}
		60% {
			opacity: 1;
		}
		to {
			opacity: 1;
			transform: translateX(0) rotate(0deg);
		}
	}

	@keyframes logo-wm-fade-in {
		from {
			opacity: 0;
			transform: translateY(10%);
		}
		to {
			opacity: 1;
			transform: translateY(0);
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.logo__isotipo :global(.iso-shape),
		.logo__wordmark :global(.wm-letter) {
			animation: none;
			opacity: 1;
			transform: none;
		}
	}
</style>
