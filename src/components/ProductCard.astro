---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';

interface Props {
	product: CollectionEntry<'productos'>;
}

const { product } = Astro.props;
const { nombre, categoria, descripcion, imagen, imagenAlt } = product.data;
---

<a href={`/catalogo/${product.id}`} class="product-card">
	<div class="product-card__image">
		<Image src={imagen} alt={imagenAlt ?? nombre} width={400} height={300} />
	</div>
	<div class="product-card__body">
		<p class="product-card__category">{categoria}</p>
		<h3>{nombre}</h3>
		<p class="product-card__desc">{descripcion}</p>
	</div>
</a>

<style>
	.product-card {
		display: flex;
		flex-direction: column;
		text-decoration: none;
		color: inherit;
		border: 1px solid var(--color-border);
		border-radius: var(--radius-md);
		overflow: hidden;
		background: var(--color-white);
		transition: box-shadow 0.2s ease, transform 0.2s ease;
	}

	.product-card:hover {
		box-shadow: 0 12px 28px rgba(43, 47, 51, 0.12);
		transform: translateY(-2px);
	}

	.product-card__image {
		aspect-ratio: 4 / 3;
		overflow: hidden;
	}

	.product-card__image :global(img) {
		width: 100%;
		height: 100%;
		object-fit: cover;
	}

	.product-card__body {
		padding: 20px;
		display: flex;
		flex-direction: column;
		gap: 8px;
	}

	.product-card__category {
		font-family: var(--font-heading);
		font-weight: 700;
		font-size: 0.75rem;
		text-transform: uppercase;
		letter-spacing: 0.06em;
		color: var(--color-primary);
	}

	.product-card__body h3 {
		font-size: 1.1rem;
	}

	.product-card__desc {
		font-size: 0.9rem;
		line-height: 1.55;
		color: var(--color-graphite-soft);
		display: -webkit-box;
		-webkit-line-clamp: 3;
		-webkit-box-orient: vertical;
		overflow: hidden;
	}
</style>
