---
import Logo from './Logo.astro';

const currentYear = new Date().getFullYear();

const linkColumns = [
	{
		title: 'Navegación',
		links: [
			{ label: 'Catálogo', href: '/catalogo' },
			{ label: 'Nosotros', href: '/#nosotros' },
			{ label: 'Contacto', href: '/#hablemos' },
		],
	},
	{
		title: 'Categorías',
		links: [
			{ label: 'Acero al Silicio', href: '/catalogo' },
			{ label: 'Serie Uni-Core', href: '/catalogo' },
			{ label: 'Núcleos Toroidales', href: '/catalogo' },
		],
	},
];

const socialLinks = [
	{ label: 'LinkedIn', href: 'https://www.linkedin.com' },
	{ label: 'Instagram', href: 'https://www.instagram.com/zolvensas/' },
];
---

<footer class="site-footer">
	<div class="container site-footer__inner">
		<div class="site-footer__brand">
			<Logo size={32} variant="light" />
			<p>Materiales y componentes eléctricos, directo de fábrica.</p>
		</div>

		<div class="site-footer__columns">
			{
				linkColumns.map((col) => (
					<div>
						<h4>{col.title}</h4>
						<ul>
							{col.links.map((link) => (
								<li>
									<a href={link.href}>{link.label}</a>
								</li>
							))}
						</ul>
					</div>
				))
			}

			<div>
				<h4>Síguenos</h4>
				<ul>
					{
						socialLinks.map((social) => (
							<li>
								<a href={social.href} target="_blank" rel="noopener noreferrer">
									{social.label}
								</a>
							</li>
						))
					}
				</ul>
			</div>
		</div>
	</div>

	<div class="site-footer__bottom">
		<div class="container">
			<p>&copy; {currentYear} Zolven. Todos los derechos reservados.</p>
		</div>
	</div>
</footer>

<style>
	.site-footer {
		background: var(--color-footer-bg);
		color: #c9cbce;
	}

	.site-footer__inner {
		display: grid;
		grid-template-columns: 1.2fr 2fr;
		gap: 48px;
		padding-top: 64px;
		padding-bottom: 40px;
	}

	.site-footer__brand p {
		margin-top: 16px;
		font-size: 0.9rem;
		line-height: 1.6;
		max-width: 32ch;
		color: #a6a9ad;
	}

	.site-footer__columns {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: 24px;
	}

	.site-footer__columns h4 {
		font-family: var(--font-heading);
		font-weight: 700;
		font-size: 0.85rem;
		text-transform: uppercase;
		letter-spacing: 0.05em;
		color: var(--color-white);
		margin-bottom: 16px;
	}

	.site-footer__columns ul {
		list-style: none;
		margin: 0;
		padding: 0;
		display: flex;
		flex-direction: column;
		gap: 10px;
	}

	.site-footer__columns a {
		text-decoration: none;
		color: #b7b9bc;
		font-size: 0.9rem;
	}

	.site-footer__columns a:hover {
		color: var(--color-primary);
	}

	.site-footer__bottom {
		border-top: 1px solid rgba(255, 255, 255, 0.08);
		padding: 20px 0;
	}

	.site-footer__bottom p {
		font-size: 0.8rem;
		color: #8b8e91;
	}

	@media (max-width: 720px) {
		.site-footer__inner {
			grid-template-columns: 1fr;
		}

		.site-footer__columns {
			grid-template-columns: 1fr 1fr;
		}
	}
</style>
