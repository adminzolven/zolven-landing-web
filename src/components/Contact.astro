---
const contactCards = [
	{
		icon: '📞',
		label: 'Teléfono',
		value: '+57 300 000 0000',
	},
	{
		icon: '✉️',
		label: 'Correo',
		value: 'contacto@zolven.com',
	},
	{
		icon: '💬',
		label: 'WhatsApp',
		value: '+57 300 000 0000',
	},
];

const countryCodes = [
	{ code: '+57', label: '🇨🇴 +57' },
	{ code: '+1', label: '🇺🇸 +1' },
	{ code: '+52', label: '🇲🇽 +52' },
	{ code: '+34', label: '🇪🇸 +34' },
	{ code: '+51', label: '🇵🇪 +51' },
	{ code: '+56', label: '🇨🇱 +56' },
];
---

<section id="hablemos" class="contact">
	<div class="container contact__inner">
		<div class="contact__left">
			<p class="eyebrow">Hablemos</p>
			<h2>Cuéntanos qué necesitas</h2>
			<p class="contact__intro">
				Escríbenos y un especialista de Zolven te ayudará a encontrar el
				material o componente exacto para tu proyecto.
			</p>

			<div class="contact__cards">
				{
					contactCards.map((card) => (
						<div class="contact-card">
							<span class="contact-card__icon" aria-hidden="true">
								{card.icon}
							</span>
							<div>
								<p class="contact-card__label">{card.label}</p>
								<p class="contact-card__value">{card.value}</p>
							</div>
						</div>
					))
				}
			</div>
		</div>

		<form class="contact-form" method="post">
			<div class="field field--full">
				<label for="email">Correo corporativo</label>
				<input type="email" id="email" name="email" required placeholder="tu@empresa.com" />
			</div>

			<div class="field">
				<label for="nombre">Nombre</label>
				<input type="text" id="nombre" name="nombre" required />
			</div>
			<div class="field">
				<label for="apellido">Apellido</label>
				<input type="text" id="apellido" name="apellido" required />
			</div>

			<div class="field">
				<label for="empresa">Empresa <span>(opcional)</span></label>
				<input type="text" id="empresa" name="empresa" />
			</div>
			<div class="field">
				<label for="cargo">Cargo <span>(opcional)</span></label>
				<input type="text" id="cargo" name="cargo" />
			</div>

			<div class="field field--full">
				<label for="telefono">Teléfono</label>
				<div class="phone-input">
					<select id="pais" name="pais" aria-label="Código de país">
						{countryCodes.map((c) => <option value={c.code}>{c.label}</option>)}
					</select>
					<input type="tel" id="telefono" name="telefono" placeholder="300 000 0000" />
				</div>
			</div>

			<div class="field field--full">
				<label for="mensaje">Mensaje</label>
				<textarea id="mensaje" name="mensaje" rows="5" required></textarea>
			</div>

			<button type="submit" class="btn btn-primary field--full">Enviar solicitud</button>
		</form>
	</div>
</section>

<style>
	.contact {
		background: var(--color-white);
	}

	.contact__inner {
		display: grid;
		grid-template-columns: 0.85fr 1.15fr;
		gap: 56px;
	}

	.contact__left h2 {
		font-size: clamp(1.6rem, 3vw, 2.2rem);
		margin: 12px 0 16px;
	}

	.contact__intro {
		color: var(--color-graphite-soft);
		line-height: 1.6;
		margin-bottom: 32px;
		max-width: 42ch;
	}

	.contact__cards {
		display: flex;
		flex-direction: column;
		gap: 14px;
	}

	.contact-card {
		display: flex;
		align-items: center;
		gap: 14px;
		border: 1px solid var(--color-border);
		border-radius: var(--radius-md);
		padding: 18px 20px;
	}

	.contact-card__icon {
		font-size: 1.4rem;
		line-height: 1;
	}

	.contact-card__label {
		font-family: var(--font-heading);
		font-weight: 700;
		font-size: 0.9rem;
		margin-bottom: 2px;
	}

	.contact-card__value {
		color: var(--color-graphite-soft);
		font-size: 0.9rem;
	}

	.contact-form {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 20px;
	}

	.field {
		display: flex;
		flex-direction: column;
		gap: 6px;
	}

	.field--full {
		grid-column: 1 / -1;
	}

	.field label {
		font-family: var(--font-heading);
		font-weight: 700;
		font-size: 0.85rem;
	}

	.field label span {
		font-family: var(--font-body);
		font-weight: 400;
		color: var(--color-graphite-soft);
	}

	.field input,
	.field textarea,
	.field select {
		font-family: var(--font-body);
		font-size: 0.95rem;
		border: 1px solid var(--color-border);
		border-radius: var(--radius-sm);
		padding: 12px 14px;
		background: var(--color-white);
		color: var(--color-graphite);
	}

	.field input:focus,
	.field textarea:focus,
	.field select:focus {
		outline: 2px solid var(--color-primary);
		outline-offset: 1px;
	}

	.phone-input {
		display: grid;
		grid-template-columns: 110px 1fr;
		gap: 10px;
	}

	.phone-input select,
	.phone-input input {
		width: 100%;
	}

	button.btn {
		margin-top: 8px;
	}

	@media (max-width: 900px) {
		.contact__inner {
			grid-template-columns: 1fr;
		}
	}

	@media (max-width: 560px) {
		.contact-form {
			grid-template-columns: 1fr;
		}
	}
</style>
