---
import Icon from './Icon.astro';
import { getCountries, getCountryCallingCode } from 'libphonenumber-js/min';

const contactCards = [
	{
		icon: 'correo',
		label: 'Correo',
		value: 'andrea.restrepo@zolvencorp.com',
	},
	{
		icon: 'whatsapp',
		label: 'WhatsApp',
		value: '+57 315 488 5463',
	},
];

// Bandera a partir del código ISO (dos indicadores regionales Unicode).
function banderaEmoji(iso: string) {
	return iso
		.toUpperCase()
		.replace(/./g, (letra) => String.fromCodePoint(127397 + letra.charCodeAt(0)));
}

const nombresPaisesEs = new Intl.DisplayNames(['es'], { type: 'region' });

// value del <option> = código ISO (lo que necesita libphonenumber-js para
// validar); el texto visible se mantiene compacto (bandera + indicativo)
// para no cambiar el ancho/diseño del selector.
const countryOptions = getCountries()
	.map((iso) => {
		try {
			return {
				iso,
				nombre: nombresPaisesEs.of(iso) ?? iso,
				bandera: banderaEmoji(iso),
				indicativo: getCountryCallingCode(iso),
			};
		} catch {
			return null;
		}
	})
	.filter((pais): pais is NonNullable<typeof pais> => pais !== null)
	.sort((a, b) => a.nombre.localeCompare(b.nombre, 'es'));
---

<section id="hablemos" class="contact">
	<div class="container contact__inner">
		<div class="contact__left">
			<p class="eyebrow">Hablemos</p>
			<h2>Cuéntanos qué necesitas</h2>
			<p class="contact__intro">
				Escríbenos y un especialista de Zolven te ayudará a encontrar el
				material o componente exacto para tu proyecto.
			</p>

			<div class="contact__cards">
				{
					contactCards.map((card) => (
						<div class="contact-card">
							<Icon name={card.icon} variant="primary" size={40} />
							<div>
								<p class="contact-card__label">{card.label}</p>
								<p class="contact-card__value">{card.value}</p>
							</div>
						</div>
					))
				}
			</div>
		</div>

		<form id="form-contacto" class="contact-form" novalidate>
			<div class="field field--full">
				<label for="correo">Correo corporativo</label>
				<input
					type="email"
					id="correo"
					name="correo"
					required
					placeholder="tu@empresa.com"
					pattern="[^\s@]+@[^\s@]+\.[A-Za-z]{2,}"
					aria-describedby="correo-error"
				/>
				<p id="correo-error" class="field-error" role="alert" hidden></p>
			</div>

			<div class="field">
				<label for="nombre">Nombre</label>
				<input type="text" id="nombre" name="nombre" required />
			</div>
			<div class="field">
				<label for="apellido">Apellido</label>
				<input type="text" id="apellido" name="apellido" required />
			</div>

			<div class="field">
				<label for="empresa">Empresa <span>(opcional)</span></label>
				<input type="text" id="empresa" name="empresa" />
			</div>
			<div class="field">
				<label for="cargo">Cargo <span>(opcional)</span></label>
				<input type="text" id="cargo" name="cargo" />
			</div>

			<div class="field field--full">
				<label for="telefono">Teléfono</label>
				<div class="phone-input">
					<select id="pais" name="pais" aria-label="País">
						{
							countryOptions.map((c) => (
								<option value={c.iso} selected={c.iso === 'CO'}>
									{c.bandera} +{c.indicativo}
								</option>
							))
						}
					</select>
					<input
						type="tel"
						id="telefono"
						name="telefono"
						placeholder="300 000 0000"
						inputmode="tel"
						pattern="[0-9+\-()\s]*"
						aria-describedby="telefono-error"
					/>
				</div>
				<p id="telefono-error" class="field-error" role="alert" hidden></p>
			</div>

			<div class="field field--full">
				<label for="mensaje">Mensaje</label>
				<textarea id="mensaje" name="mensaje" rows="5" required></textarea>
			</div>

			<!-- Campo trampa anti-spam: invisible para las personas, no lo borres -->
			<input
				type="text"
				name="website"
				class="contact-form__trap"
				tabindex="-1"
				autocomplete="off"
				aria-hidden="true"
			/>

			<button type="submit" class="btn btn-primary field--full">Enviar solicitud</button>
			<p id="form-estado" class="form-estado field--full" role="status" aria-live="polite"></p>
		</form>
	</div>
</section>

<style>
	.contact {
		background: var(--color-white);
		padding: 32px 0;
		scroll-margin-top: 96px;
	}

	@media (max-width: 1023px) {
		.contact {
			scroll-margin-top: 80px;
		}
	}

	.contact__inner {
		display: grid;
		grid-template-columns: 0.85fr 1.15fr;
		gap: 56px;
	}

	.contact__left h2 {
		font-size: clamp(1.6rem, 3vw, 2.2rem);
		margin: 12px 0 16px;
	}

	.contact__intro {
		color: var(--color-graphite-soft);
		line-height: 1.6;
		margin-bottom: 32px;
		max-width: 42ch;
	}

	.contact__cards {
		display: flex;
		flex-direction: column;
		gap: 14px;
	}

	.contact-card {
		display: flex;
		align-items: center;
		gap: 14px;
		border: 1px solid var(--color-border);
		border-radius: var(--radius-md);
		padding: 18px 20px;
	}

	.contact-card__label {
		font-family: var(--font-heading);
		font-weight: 700;
		font-size: 0.9rem;
		margin-bottom: 2px;
	}

	.contact-card__value {
		color: var(--color-graphite-soft);
		font-size: 0.9rem;
	}

	.contact-form {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 20px;
	}

	.field {
		display: flex;
		flex-direction: column;
		gap: 6px;
	}

	.field--full {
		grid-column: 1 / -1;
	}

	.field label {
		font-family: var(--font-heading);
		font-weight: 700;
		font-size: 0.85rem;
	}

	.field label span {
		font-family: var(--font-body);
		font-weight: 400;
		color: var(--color-graphite-soft);
	}

	.field input,
	.field textarea,
	.field select {
		font-family: var(--font-body);
		font-size: 0.95rem;
		border: 1px solid var(--color-border);
		border-radius: var(--radius-sm);
		padding: 12px 14px;
		background: var(--color-white);
		color: var(--color-graphite);
	}

	.field input:focus,
	.field textarea:focus,
	.field select:focus {
		outline: 2px solid var(--color-primary);
		outline-offset: 1px;
	}

	.phone-input {
		display: grid;
		grid-template-columns: 110px 1fr;
		gap: 10px;
	}

	.phone-input select,
	.phone-input input {
		width: 100%;
	}

	button.btn {
		margin-top: 8px;
	}

	.contact-form__trap {
		position: absolute;
		left: -9999px;
		width: 1px;
		height: 1px;
		opacity: 0;
	}

	.form-estado {
		font-size: 0.9rem;
		color: var(--color-graphite-soft);
		min-height: 1.2em;
	}

	.field-error {
		font-size: 0.8rem;
		color: #c0392b;
	}

	.field:has(.field-error:not([hidden])) input {
		border-color: #c0392b;
	}

	@media (max-width: 900px) {
		.contact__inner {
			grid-template-columns: 1fr;
		}
	}

	@media (max-width: 560px) {
		.contact-form {
			grid-template-columns: 1fr;
		}
	}
</style>

<script>
	import { parsePhoneNumberFromString } from 'libphonenumber-js/min';
	import type { CountryCode } from 'libphonenumber-js/min';

	// URL de la aplicación web de Apps Script que guarda los envíos en Google Sheets.
	const URL_SHEETS =
		'https://script.google.com/macros/s/AKfycbwt1e79sA-d28lKvn8tW9jdl1Xv_PNqU7aF2kvmYZo6iXq5yxvpyf6PB0kssh8yCNum/exec';

	const form = document.getElementById('form-contacto') as HTMLFormElement;
	const estado = document.getElementById('form-estado') as HTMLElement;
	const boton = form.querySelector('button[type="submit"]') as HTMLButtonElement;

	const correoInput = document.getElementById('correo') as HTMLInputElement;
	const correoError = document.getElementById('correo-error') as HTMLElement;
	const telefonoInput = document.getElementById('telefono') as HTMLInputElement;
	const telefonoError = document.getElementById('telefono-error') as HTMLElement;
	const paisSelect = document.getElementById('pais') as HTMLSelectElement;

	const CORREO_REGEX = /^[^\s@]+@[^\s@]+\.[A-Za-z]{2,}$/;

	const nombresPaises = new Intl.DisplayNames(['es'], { type: 'region' });
	function nombrePais(iso: string) {
		try {
			return nombresPaises.of(iso) ?? iso;
		} catch {
			return iso;
		}
	}

	function mostrarError(input: HTMLInputElement, errorEl: HTMLElement, mensaje: string) {
		input.setCustomValidity(mensaje);
		errorEl.textContent = mensaje;
		errorEl.hidden = false;
	}

	function limpiarError(input: HTMLInputElement, errorEl: HTMLElement) {
		input.setCustomValidity('');
		errorEl.textContent = '';
		errorEl.hidden = true;
	}

	function validarCorreo() {
		correoInput.value = correoInput.value.trim();

		if (correoInput.value === '') {
			limpiarError(correoInput, correoError);
			return;
		}

		if (!CORREO_REGEX.test(correoInput.value)) {
			mostrarError(correoInput, correoError, 'Escribe un correo válido, como nombre@empresa.com');
		} else {
			limpiarError(correoInput, correoError);
		}
	}

	function validarTelefono() {
		telefonoInput.value = telefonoInput.value.trim();

		if (telefonoInput.value === '') {
			limpiarError(telefonoInput, telefonoError);
			return;
		}

		// Si el número trae indicativo (+52...) libphonenumber-js lo detecta y
		// valida contra ese país, aunque no coincida con el select.
		const paisSeleccionado = paisSelect.value as CountryCode;
		const numero = parsePhoneNumberFromString(telefonoInput.value, paisSeleccionado);

		if (!numero || !numero.isValid()) {
			const paisDelMensaje = numero?.country ?? paisSeleccionado;
			mostrarError(
				telefonoInput,
				telefonoError,
				`El número no es válido para ${nombrePais(paisDelMensaje)}`,
			);
		} else {
			limpiarError(telefonoInput, telefonoError);
		}
	}

	correoInput.addEventListener('blur', validarCorreo);

	// Bloquea letras y símbolos no permitidos mientras se escribe (no solo al enviar).
	telefonoInput.addEventListener('input', () => {
		const limpio = telefonoInput.value.replace(/[^\d\s+\-()]/g, '');
		if (limpio !== telefonoInput.value) telefonoInput.value = limpio;
	});
	telefonoInput.addEventListener('blur', validarTelefono);
	paisSelect.addEventListener('change', validarTelefono);

	form.addEventListener('submit', async (event) => {
		event.preventDefault();

		validarCorreo();
		validarTelefono();

		if (!form.checkValidity()) {
			form.reportValidity();
			return;
		}

		boton.disabled = true;
		estado.textContent = 'Enviando…';

		// La hoja de Google guarda el nombre del país (no el código ISO) y el
		// teléfono ya normalizado en formato internacional.
		const datos = new FormData(form);
		datos.set('pais', nombrePais(paisSelect.value));

		if (telefonoInput.value !== '') {
			const numero = parsePhoneNumberFromString(telefonoInput.value, paisSelect.value as CountryCode);
			if (numero?.isValid()) {
				datos.set('telefono', numero.formatInternational());
			}
		}

		try {
			const respuesta = await fetch(URL_SHEETS, {
				method: 'POST',
				body: new URLSearchParams(datos as any),
			});
			const resultado = await respuesta.json();
			if (!resultado.ok) throw new Error(resultado.error);

			form.reset();
			estado.textContent = 'Mensaje enviado. Te responderemos pronto.';
		} catch (error) {
			estado.textContent =
				'No se pudo enviar el mensaje. Revisa tu conexión e inténtalo de nuevo.';
		} finally {
			boton.disabled = false;
		}
	});
</script>
