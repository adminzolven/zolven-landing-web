---
interface Item {
	label: string;
	href?: string;
}

interface Props {
	items: Item[];
}

const { items } = Astro.props;
---

<nav class="breadcrumbs" aria-label="Ruta de navegación">
	<ol>
		{
			items.map((item, i) => (
				<li>
					{item.href ? <a href={item.href}>{item.label}</a> : <span aria-current="page">{item.label}</span>}
					{i < items.length - 1 && (
						<svg class="breadcrumbs__chevron" viewBox="0 0 24 24" fill="none" aria-hidden="true">
							<path d="M9 6l6 6-6 6" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
						</svg>
					)}
				</li>
			))
		}
	</ol>
</nav>

<style>
	.breadcrumbs {
		margin-bottom: 20px;
	}

	.breadcrumbs ol {
		display: flex;
		align-items: center;
		flex-wrap: wrap;
		gap: 6px;
		list-style: none;
		margin: 0;
		padding: 0;
	}

	.breadcrumbs li {
		display: flex;
		align-items: center;
		gap: 6px;
	}

	.breadcrumbs a,
	.breadcrumbs span {
		font-family: var(--font-body);
		font-size: 0.82rem;
	}

	.breadcrumbs a {
		color: var(--color-secondary-2);
		text-decoration: none;
	}

	.breadcrumbs a:hover {
		text-decoration: underline;
	}

	.breadcrumbs span[aria-current] {
		color: var(--color-graphite);
	}

	.breadcrumbs__chevron {
		width: 14px;
		height: 14px;
		flex-shrink: 0;
		color: var(--color-border);
	}
</style>
