---
import Logo from './Logo.astro';

const navLinks = [
	{ label: 'Catálogo', href: '/catalogo' },
	{ label: 'Nosotros', href: '/#nosotros' },
	{ label: 'Contacto', href: '/#hablemos' },
];
---

<header class="site-header">
	<div class="container site-header__inner">
		<Logo size={34} variant="light" class="site-header__logo" />

		<nav class="site-header__nav" aria-label="Navegación principal">
			<ul>
				{
					navLinks.map((link) => (
						<li>
							<a href={link.href}>{link.label}</a>
						</li>
					))
				}
			</ul>
		</nav>

		<a href="/#hablemos" class="btn btn-primary site-header__cta">Contáctanos</a>
	</div>
</header>

<style>
	.site-header {
		background: var(--color-hero-bg);
		position: relative;
		z-index: 10;
	}

	.site-header__inner {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 24px;
		padding-top: 20px;
		padding-bottom: 20px;
	}

	.site-header__nav ul {
		list-style: none;
		display: flex;
		gap: 32px;
		margin: 0;
		padding: 0;
	}

	.site-header__nav a {
		color: var(--color-white);
		text-decoration: none;
		font-family: var(--font-body);
		font-weight: 500;
		font-size: 0.95rem;
		opacity: 0.85;
		transition: opacity 0.2s ease;
	}

	.site-header__nav a:hover {
		opacity: 1;
	}

	.site-header__cta {
		flex-shrink: 0;
		padding: 10px 22px;
	}

	@media (max-width: 720px) {
		.site-header__nav {
			display: none;
		}
	}
</style>
