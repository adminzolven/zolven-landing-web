---
import Layout from '../layouts/Layout.astro';
---

<Layout
	title="Gracias por tu mensaje"
	description="Hemos recibido tu solicitud. Un especialista de Zolven se pondrá en contacto contigo pronto."
>
	<section class="thanks">
		<div class="container thanks__inner">
			<p class="eyebrow">Mensaje enviado</p>
			<h1>¡Gracias por escribirnos!</h1>
			<p class="thanks__text">
				Un especialista de Zolven revisará tu solicitud y se pondrá en contacto contigo lo antes
				posible.
			</p>
			<a href="/" class="btn btn-primary">Volver al inicio</a>
		</div>
	</section>
</Layout>

<style>
	.thanks {
		padding: 96px 0;
		text-align: center;
	}

	.thanks__inner {
		max-width: 52ch;
		margin: 0 auto;
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 16px;
	}

	.thanks h1 {
		font-size: clamp(1.8rem, 3.5vw, 2.4rem);
		margin: 0;
	}

	.thanks__text {
		color: var(--color-graphite-soft);
		line-height: 1.6;
	}

	.thanks .btn {
		margin-top: 12px;
	}
</style>
